@startuml Voting System API Use Case Diagram

left to right direction

actor "User" as user

rectangle "Voting System API" {
  usecase "Register\nPOST v1/auth/register" as UC1
  usecase "Login\nPOST v1/auth/login" as UC2
  usecase "Create Event\nPOST v1/event/create" as UC3
  usecase "Get Event Leaderboard\nGET v1/event/{event_id}/leaderboard" as UC4
  usecase "Get Contestants List\nGET v1/contestants/{event_id}" as UC5
  usecase "Submit Vote\nPOST v1/vote/submit" as UC6
  usecase "Verify Vote Status\nGET v1/vote/{vote_id}/status" as UC7
}

user --> UC1
user --> UC2
user --> UC3
user --> UC4
user --> UC5
user --> UC6
user --> UC7

@enduml
